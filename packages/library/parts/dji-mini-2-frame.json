      "reference": "Flight controller, OcuSync 2.0 radio and sensors in a hover"
    },
    "maxCurrent": {
      "value": 6,
      "unit": "A",
      "source": "estimated",
      "reference": "ESCs built into the flight controller board; DJI doesn't publish a rating"
    }
  },
  "model": "module",
